# systemd unit for the STAGING storefront (dev branch), served at https://ip79-99-44-153.pbiaas.com.
#   sudo cp deploy/wdlocks-staging.service /etc/systemd/system/ && sudo systemctl enable --now wdlocks-staging
# Releases are installed by /usr/local/sbin/wdlocks-deploy (deploy/wdlocks-deploy.sh); `current` points at the live one.
# Settings live in /srv/wdlocks-staging/shared/.env.production. NEXT_PUBLIC_* values are baked in at build time,
# so redeploy after changing those.

[Unit]
Description=WD Locks storefront - staging (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Own user, NOT wdlocks: staging code is deployed automatically from GitHub and must not reach production's settings.
User=wdlocks-stg
Group=wdlocks-stg
WorkingDirectory=/srv/wdlocks-staging/current
EnvironmentFile=/srv/wdlocks-staging/shared/.env.production
Environment=NODE_ENV=production
Environment=CLIENT_IP_HEADER=x-real-ip
Environment=NEXT_TELEMETRY_DISABLED=1
# 127.0.0.1 only: the app is reachable through Caddy, never directly.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3001
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true
ProtectHome=true
# Second wall behind the file permissions: production, WordPress and backups do not exist for this service.
InaccessiblePaths=/srv/wdlocks-production /srv/wordpress /srv/backups /srv/restore /srv/wdlocks-frontend /root

[Install]
WantedBy=multi-user.target

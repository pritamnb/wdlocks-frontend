# systemd unit for the Next.js app on a plain Linux server (README "Running on a plain server").
#   sudo cp deploy/wdlocks-frontend.service /etc/systemd/system/
#   sudo systemctl enable --now wdlocks-frontend
# Settings live in /srv/wdlocks-frontend/.env.production (see .env.local.example); change them there and
# `sudo systemctl restart wdlocks-frontend`. NEXT_PUBLIC_* values are baked in by `npm run build`, so rebuild for those.

[Unit]
Description=WD Locks storefront (Next.js)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=wdlocks
WorkingDirectory=/srv/wdlocks-frontend
EnvironmentFile=/srv/wdlocks-frontend/.env.production
Environment=NODE_ENV=production
Environment=CLIENT_IP_HEADER=x-real-ip
# 127.0.0.1 only: the app is reachable through Caddy (deploy/Caddyfile), never directly.
ExecStart=/usr/bin/npm run start -- -H 127.0.0.1 -p 3000
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=full
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Live payment keys for the production server (docs/go-live-payments.md).
#
# Copy to .env.live (gitignored) and fill in. Read ONLY by `node scripts/stripe-setup.mjs --target server`, which checks
# the keys, registers the live webhook and the wallet domain, and writes .env.server for the server.
# Never put live keys in .env.local: every local `next dev` / `next start` reads that file and would charge real cards.

# The shop's public address once the new site takes over the domain, and where WordPress/WooCommerce lives then.
NEXT_PUBLIC_SITE_URL=https://wdlocks.co.uk
NEXT_PUBLIC_WC_BASE=https://wdlocks.co.uk

# Stripe Dashboard, LIVE mode (test-mode switch off) → Developers → API keys. Use the Copy buttons; never paste in chat.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_
STRIPE_SECRET_KEY=sk_live_
# Written for you when the script creates the live webhook endpoint (shown by Stripe only once).
STRIPE_WEBHOOK_SECRET=

# WooCommerce → Settings → Advanced → REST API → Add key: description "Headless checkout (production)",
# permissions Read/Write. A separate key from the staging one, so either can be revoked on its own.
WC_CONSUMER_KEY=ck_
WC_CONSUMER_SECRET=cs_

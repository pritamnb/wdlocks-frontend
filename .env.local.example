# Public URL of THIS frontend (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooCommerce backend (no trailing slash). Store API is read from $NEXT_PUBLIC_WC_BASE/wp-json/wc/store/v1
NEXT_PUBLIC_WC_BASE=https://wdlocks.co.uk

# Set to true ONLY after installing backend/wd-cart-handoff.php on WordPress.
# false = native WooCommerce add-to-cart handoff, which supports single-line baskets only.
NEXT_PUBLIC_CART_HANDOFF_PLUGIN=false

# Contact page email delivery (optional). Without a key the forms fall back to the visitor's mail app.
# RESEND_API_KEY=re_xxx
# CONTACT_TO=sales@wdlocks.co.uk
# CONTACT_FROM=Watchdog Locks <noreply@wdlocks.co.uk>

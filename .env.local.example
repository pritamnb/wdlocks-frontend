# Public URL of THIS frontend (no trailing slash). Used for canonical URLs, sitemap, Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WooCommerce backend (no trailing slash). Store API is read from $NEXT_PUBLIC_WC_BASE/wp-json/wc/store/v1
NEXT_PUBLIC_WC_BASE=https://wdlocks.co.uk

# Set to true ONLY after installing backend/wd-cart-handoff.php on WordPress.
# false = native WooCommerce add-to-cart handoff, which supports single-line baskets only.
NEXT_PUBLIC_CART_HANDOFF_PLUGIN=false

# Contact page email delivery (optional). Without a key the forms fall back to the visitor's mail app.
# RESEND_API_KEY=re_xxx
# CONTACT_TO=sales@wdlocks.co.uk
# CONTACT_FROM=Watchdog Locks <noreply@wdlocks.co.uk>

# Checkout on our own domain (docs/stripe-checkout-plan.md). Without these the checkout hands the basket to wdlocks.co.uk.
# Stripe keys must come from the client's OWN Stripe account (never WooPayments keys). Use test keys until launch.
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# WooCommerce REST API key (WooCommerce → Settings → Advanced → REST API, Read/Write) used to create orders.
# WC_CONSUMER_KEY=ck_xxx
# WC_CONSUMER_SECRET=cs_xxx
# Demo checkout: runs the on-site checkout against a pretend payment provider (no Stripe/WooCommerce keys needed,
# nothing is charged, no order is created). Ignored when real Stripe keys are set.
# NEXT_PUBLIC_CHECKOUT_MODE=demo

# --- Abuse protection (README "Abuse protection") -------------------------------------------------------------------
# Shared rate-limit store: anything that speaks the Upstash REST protocol (Upstash, Vercel KV's KV_REST_API_URL /
# KV_REST_API_TOKEN, or your own Redis behind serverless-redis-http). Without it each server instance counts in its
# own memory. Switching provider = changing these two values.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=xxx
# Per-route limits, overriding the defaults in src/lib/rate-limit.ts: "count/window" pairs (units s m h d), or "off".
# RATE_LIMIT_CHECKOUT_INTENT=10/1m,30/1h
# RATE_LIMIT_CHECKOUT_COUPON=8/1m,40/1h
# RATE_LIMIT_CONTACT=5/10m,20/1d
# RATE_LIMIT_TRADE=3/10m,10/1d
# RATE_LIMIT_GUARANTEE=10/10m,50/1d
# RATE_LIMIT_CRIME=20/1m,200/1d
# Where the visitor's IP comes from. On Vercel nothing is needed (x-vercel-forwarded-for). Behind another proxy either
# name ONE header the proxy overwrites, or say how many proxies append to X-Forwarded-For (default 1).
# CLIENT_IP_HEADER=x-real-ip
# TRUSTED_PROXY_COUNT=1
# Cloudflare Turnstile bot check on Place order and the contact / trade / guarantee forms. On only when BOTH are set.
# Test keys (always pass): site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Which forms are checked (build time): any of checkout,contact,trade,guarantee, or all / none. Default all.
# NEXT_PUBLIC_TURNSTILE_FORMS=all
